---
/**
 * Hero.astro — section 1.
 * chungiyoo's opening move: a small bracketed intro line, then an oversized
 * name, a role line, and two calls to action. The intro animation is driven
 * by src/scripts/motion.ts.
 *
 * EDIT ME: swap the name, the intro sentence and the CTA copy for your own.
 */
---

<section class="hero" id="top">
  <div class="wrap hero__inner">
    <p class="hero__eyebrow">
      Welcome to the workshop of <span aria-hidden="true">(</span>
    </p>

    <p class="hero__intro">
      Hi! I&rsquo;m <strong>Farah Inani</strong>, a web developer from Johor,
      Malaysia &mdash; front-end, WordPress&nbsp;&amp; Adobe Experience Manager.
      But you can call me Fara. <span aria-hidden="true">)</span>
    </p>

    {/* Trailing space inside the first line keeps screen readers reading
        "farah inani" as two words. */}
    <h1 class="hero__name">
      <span class="line"><span>farah </span></span>
      <span class="line"><span>inani</span></span>
    </h1>

    <p class="hero__role">
      Web Developer <span class="amp" aria-hidden="true">&amp;</span>
      <span class="visually-hidden">and</span> Front-End Engineer
    </p>

    <div class="hero__actions">
      <a class="pill" href="#contact">Let&rsquo;s build your story</a>
      <a class="text-link" href="#about">
        More about me <span aria-hidden="true">&darr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding-block: var(--space-xl) var(--space-lg);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-sm);
  }

  .hero__eyebrow {
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
  }

  .hero__intro {
    max-width: var(--measure);
    font-size: var(--text-sm);
    color: color-mix(in oklab, var(--fg) 75%, var(--bg));
  }

  .hero__intro strong {
    color: var(--fg);
    font-weight: 600;
  }

  .hero__name {
    font-size: var(--text-display);
    margin-block: var(--space-2xs);
  }

  /* Each line is a clipping window; the inner <span> is what slides up. */
  .hero__name .line {
    display: block;
    overflow: hidden;
    padding-block: 0.08em; /* room for descenders / swashes */
  }

  .hero__name .line > span {
    display: block;
  }

  .hero__role {
    font-size: var(--text-lg);
    font-family: var(--font-display);
    font-variation-settings: "opsz" 48, "SOFT" 40, "WONK" 0, "wght" 380;
  }

  .hero__role .amp {
    color: var(--accent);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .pill {
    display: inline-block;
    padding: 0.9em 1.6em;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  .pill:hover {
    background: var(--accent);
    transform: translateY(-2px);
  }

  .text-link {
    font-size: var(--text-sm);
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .text-link span {
      display: inline-block;
      animation: nudge 1.6s ease-in-out infinite;
    }
  }

  @keyframes nudge {
    50% {
      transform: translateY(3px);
    }
  }
</style>
