# Normalise line endings — store everything as LF in the repo
* text=auto eol=lf

# Binary assets (never touch line endings / never diff)
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.avif  binary
*.gif   binary
*.pdf   binary
